#!/usr/bin/env bash
set -euo pipefail

# Re-run when AUR list changes:
# aur: {{ include "packages/arch/aur.txt" | sha256sum }}

ID="unknown"
ID_LIKE=""
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  source /etc/os-release
fi

case " ${ID} ${ID_LIKE} " in
  *" arch "*|*" cachyos "*|*" endeavouros "*) ;;
  *)
    echo "Skipping AUR packages on ${ID}."
    exit 0
    ;;
esac

aur_file="{{ .chezmoi.sourceDir }}/packages/arch/aur.txt"

if ! command -v paru >/dev/null 2>&1; then
  echo "paru is not installed; skipping AUR packages."
  exit 0
fi

grep -vE "^[[:space:]]*($|#)" "$aur_file" | while read -r pkg; do
  echo "==> Installing AUR package: $pkg"
  paru -S --needed --noconfirm "$pkg" || echo "!! Failed/skipped AUR package: $pkg"
done
